# Copy this file to .env and fill in real values before running the app.

# Base URL of the separate backend project (tRPC API), e.g.
# https://api.tripping.example.com — leave empty to call same-origin
# "/api/trpc" (useful in dev if you proxy the backend through Vite).
VITE_API_URL=

# 네이버 지도(Dynamic Map) Client ID. 네이버 클라우드 플랫폼 > Maps > Application에서
# 발급하며, "Web 서비스 URL"에 이 앱이 뜨는 주소를 등록해야 동작한다.
# 개발용과 운영용 Application을 따로 만들어 각자 URL을 등록하는 것을 권장한다.
# 비워두면 상품 상세의 동선이 지도 대신 순서 도식으로 표시된다.
# Client Secret은 넣지 않는다 — VITE_ 변수는 빌드 결과에 그대로 노출된다.
VITE_NAVER_MAP_CLIENT_ID=
